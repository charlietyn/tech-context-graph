{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CONTRACT-002 TechnologyContextResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "technology",
    "requestedVersion",
    "sourceRefs",
    "matches",
    "warnings",
    "queryDurationMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "READY",
        "STALE",
        "MISSING",
        "FAILED"
      ]
    },
    "technology": {
      "type": "string"
    },
    "requestedVersion": {
      "type": "string"
    },
    "resolvedVersion": {
      "type": "string"
    },
    "graphHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inspectionAt": {
      "type": "string"
    },
    "freshnessCheckedAt": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repositoryId",
          "repositoryKey",
          "repositoryCommit",
          "sourceFingerprint",
          "graphDigestSha256",
          "graphifyVersion",
          "publishedAt",
          "pointerInspectionId"
        ],
        "properties": {
          "repositoryId": {
            "type": "string",
            "minLength": 1
          },
          "repositoryKey": {
            "type": "string",
            "minLength": 1
          },
          "repositoryCommit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40,64}$"
              }
            ]
          },
          "sourceFingerprint": {
            "type": "string",
            "minLength": 1
          },
          "graphDigestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "graphifyVersion": {
            "type": "string",
            "minLength": 1
          },
          "publishedAt": {
            "type": "string",
            "minLength": 1
          },
          "pointerInspectionId": {
            "type": "string",
            "minLength": 1
          },
          "fileRef": {
            "type": "string"
          },
          "lineStart": {
            "type": "integer",
            "minimum": 1
          },
          "lineEnd": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "references",
          "confidence"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "confidence": {
            "enum": [
              "SOURCE",
              "INDEX",
              "INFERRED"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correlationId": {
      "type": "string"
    },
    "queryDurationMs": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retryable",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "VERSION_MISMATCH",
            "GRAPH_MISSING",
            "STALE_GRAPH",
            "INTEGRITY_FAILED",
            "TIMEOUT",
            "GRAPHIFY_UNAVAILABLE",
            "QUERY_FAILED",
            "SOURCE_CHANGED",
            "OUTPUT_TOO_LARGE"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "required": [
          "graphHash",
          "resolvedVersion",
          "inspectionAt",
          "freshnessCheckedAt"
        ],
        "properties": {
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "properties": {
                "repositoryCommit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40,64}$"
                }
              },
              "type": "object"
            }
          }
        }
      },
      "else": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$comment": "Plan 28 C1 (2026-11-11): a READY result names a Git repositoryCommit for every sourceRef and always carries freshnessCheckedAt. This only narrows what the producer emits; every READY accepted now was already valid for consumers of the previous 1.0 schema, so schemaVersion stays 1.0."
}
