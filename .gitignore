# Generated release inventories; regenerate them for an actual release.
/CHECKSUMS.sha256
/MANIFEST.txt

# -----------------------------------------------------------------------------
# Tech Context Graph local workspace state
# These patterns are anchored to the repository root so public fixtures such as
# examples/**/knowledge remain trackable.
# -----------------------------------------------------------------------------
/.codex/
/.tcg/
/.tcg-install/
/.pcx/
/context-pack/
/knowledge/
/graphify-out/
/tech-graphify-out/
/tech-context-graph.workspace.json
/tech-context-graph.yaml

# Local planning and generated binary manuals are intentionally not public.
/internal-notes/
/manual/

# Reproducible raster exports; keep the editable DOT and scalable SVG sources.
/diagrams/**/*.png

# Generated manual rendering intermediates, should manual/ ever be force-added.
**/_rendered/
