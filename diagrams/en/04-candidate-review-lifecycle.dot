digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#345995", fontname="Arial", fontsize=11, margin="0.14,0.08"];
  edge [color="#52616B", fontname="Arial", fontsize=9, arrowsize=0.75];

  n0 [label="Scan root", fillcolor="#EAF2FF"];
  n1 [label="DETECTED", fillcolor="#F7F9FC"];
  n2 [label="Human review", fillcolor="#F7F9FC"];
  n3 [label="ACCEPTED", fillcolor="#F7F9FC"];
  n4 [label="Graphify inspection", fillcolor="#F7F9FC"];
  n5 [label="IGNORED / REJECTED", fillcolor="#EAF2FF"];
  n0 -> n1;
  n1 -> n2;
  n2 -> n3 [label="accept"];
  n3 -> n4;
  n2 -> n5 [label="ignore/reject"];
}
