digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#345995", fontname="Arial", fontsize=11, margin="0.14,0.08"];
  edge [color="#52616B", fontname="Arial", fontsize=9, arrowsize=0.75];

  n0 [label="Need a folder", fillcolor="#EAF2FF"];
  n1 [label="Browse", fillcolor="#F7F9FC"];
  n2 [label="Paste full path", fillcolor="#F7F9FC"];
  n3 [label="Recent folders", fillcolor="#F7F9FC"];
  n4 [label="Use current directory
advanced", fillcolor="#F7F9FC"];
  n5 [label="Validate", fillcolor="#F7F9FC"];
  n6 [label="Confirm", fillcolor="#EAF2FF"];
  n0 -> n1;
  n0 -> n2;
  n0 -> n3;
  n0 -> n4;
  n1 -> n5;
  n2 -> n5;
  n3 -> n5;
  n4 -> n5;
  n5 -> n6;
}
